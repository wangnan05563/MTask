# 依赖 / 构建产物
node_modules/
dist/
server/dist/
web/dist/
release/
build/pkg-out/

# 运行时数据与数据库（用户数据）
server/data/
logs/
perf/output/
perf/sandbox/

# 日志 / 测试临时输出
*.log

# 环境变量
.env

# ---------- 清理技能自动生成规则 (2026-09-10) ----------
# 注意：server/dist/data/ 与 server/src/data/ 为运行时数据库目录
# （server/src/db/connection.ts 按 __dirname 解析），清理时不得随 dist 删除。
/.cleanup-quarantine/
/cleanup-logs/
.scannerwork/
*.tsbuildinfo

# ---------- 清理 round-4 自动生成规则 (2026-09-18) ----------
# electron-builder 输出：package.json build.directories.output=release，
# 历史轮次改过输出目录产生 release2~release6，均为可重建产物
/release*/
# 重定向产物：误用 `> c:/Users/...` 形式在工作区建出的镜像目录
/c/Users/
# 打包/扫描日志（*.log 已覆盖，此处显式锚定根目录便于回溯）
/pack-*.log
/scan-output*.log
# SonarQube 分析批次输出（MCP 会话分批落盘，分析结束后可整体删除）
/.sonar-batch-*.txt
/.sonar-issues-*

# ---------- review 档 untrack 后的本地留存件 (2026-09-11) ----------
# 以下文件已 git rm --cached 取消跟踪（物理文件保留在磁盘，可自行删除）
/main.js
/.check_asar.cjs
/.list_c.cjs
/.main_check.txt
/TMP_init.json
/sonar-issues.json
/scripts/.build-pipe.txt
/.workbuddy/tmp/


